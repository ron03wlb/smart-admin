{
  "$schema": "https://claude.ai/schemas/hooks-v1.json",
  "version": "1.0.0",
  "description": "Automated code quality assurance hooks for SmartAdmin",
  "hooks": {
    "postAgentCompletion": {
      "java-architect": {
        "enabled": true,
        "description": "Quality assurance workflow after Java implementation",
        "sequential": true,
        "steps": [
          {
            "id": "format-code",
            "type": "bash",
            "command": "./gradlew spotlessApply",
            "description": "Format Java code with Spotless",
            "continueOnError": false,
            "timeout": 60000
          },
          {
            "id": "run-architecture-test",
            "type": "bash",
            "command": "./gradlew :sa-admin:test --tests ArchitectureTest",
            "description": "Validate architecture constraints",
            "continueOnError": false,
            "timeout": 120000
          },
          {
            "id": "code-review",
            "type": "agent",
            "agent": "code-reviewer",
            "description": "Comprehensive code quality review",
            "output": "code-review-results",
            "timeout": 300000
          },
          {
            "id": "architecture-review",
            "type": "agent",
            "agent": "architect-reviewer",
            "description": "Architecture compliance review",
            "output": "architecture-review-results",
            "timeout": 300000
          },
          {
            "id": "check-issues",
            "type": "condition",
            "condition": "hasIssues(code-review-results, architecture-review-results)",
            "description": "Check if any issues were found",
            "onTrue": "fix-issues-loop",
            "onFalse": "complete"
          },
          {
            "id": "fix-issues-loop",
            "type": "loop",
            "maxIterations": 3,
            "description": "Fix issues until none remain",
            "steps": [
              {
                "id": "aggregate-issues",
                "type": "transform",
                "input": ["code-review-results", "architecture-review-results"],
                "output": "all-issues",
                "transform": "aggregateIssues"
              },
              {
                "id": "fix-with-java-architect",
                "type": "agent",
                "agent": "java-architect",
                "prompt": "Fix the following issues:\n\n${all-issues}\n\nEnsure all fixes follow SmartAdmin patterns.",
                "output": "fix-results",
                "timeout": 600000
              },
              {
                "id": "reformat-code",
                "type": "bash",
                "command": "./gradlew spotlessApply",
                "description": "Reformat after fixes"
              },
              {
                "id": "rerun-architecture-test",
                "type": "bash",
                "command": "./gradlew :sa-admin:test --tests ArchitectureTest",
                "description": "Revalidate architecture"
              },
              {
                "id": "re-review-code",
                "type": "agent",
                "agent": "code-reviewer",
                "output": "code-review-results",
                "timeout": 300000
              },
              {
                "id": "re-review-architecture",
                "type": "agent",
                "agent": "architect-reviewer",
                "output": "architecture-review-results",
                "timeout": 300000
              },
              {
                "id": "check-remaining-issues",
                "type": "condition",
                "condition": "hasIssues(code-review-results, architecture-review-results)",
                "onTrue": "continue-loop",
                "onFalse": "break-loop"
              }
            ]
          },
          {
            "id": "record-rules",
            "type": "agent",
            "agent": "documentation-generator:technical-writer",
            "description": "Document new quality rules discovered",
            "condition": "issuesWereFixed",
            "prompt": "Update .claude/shared/knowledge/quality-standards.md with the following newly discovered rules:\n\n${fixed-issues}\n\nAdd them to the appropriate sections with examples.",
            "timeout": 300000
          },
          {
            "id": "complete",
            "type": "notification",
            "message": "✅ Code quality assurance complete. All checks passed."
          }
        ]
      }
    },
    "preCommit": {
      "enabled": true,
      "description": "Pre-commit quality checks",
      "steps": [
        {
          "id": "format-check",
          "type": "bash",
          "command": "./gradlew spotlessCheck",
          "description": "Verify code formatting",
          "continueOnError": false
        },
        {
          "id": "architecture-validation",
          "type": "bash",
          "command": "./gradlew :sa-admin:test --tests ArchitectureTest",
          "description": "Validate architecture rules",
          "continueOnError": false
        }
      ]
    }
  },
  "issueDetection": {
    "patterns": {
      "critical": [
        "🔴",
        "Critical Issue",
        "CRITICAL",
        "Security vulnerability"
      ],
      "major": [
        "🟠",
        "Major Issue",
        "MAJOR",
        "Architecture violation"
      ],
      "minor": [
        "🟡",
        "Minor Issue",
        "MINOR"
      ]
    },
    "failOnCritical": true,
    "failOnMajor": false
  },
  "ruleCollection": {
    "enabled": true,
    "destination": ".claude/shared/knowledge/quality-standards.md",
    "format": "markdown",
    "sections": {
      "antiPatterns": "## Anti-Patterns",
      "securityRules": "## Security Rules",
      "performanceRules": "## Performance Rules",
      "architectureRules": "## Architecture Rules"
    }
  }
}

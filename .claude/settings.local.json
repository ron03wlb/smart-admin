{
  "allowedCommands": {
    "claude": {
      "loops": 100
    },
    "patterns": [
      // Version control
      "Bash(git *:*)",

      // Build tools (cross-platform)
      "Bash(./gradlew *:*)",
      "Bash(gradlew.bat *:*)",

      // Container management
      "Bash(docker *:*)",
      "Bash(docker-compose *:*)",

      // System utilities
      "Bash(netstat *:*)",
      "Bash(curl *:*)",

      // Text search (cross-platform)
      "Bash(findstr *:*)",
      "Bash(grep *:*)",

      // File operations (cross-platform)
      "Bash(dir *:*)",
      "Bash(ls *:*)",
      "Bash(find *:*)",
      "Bash(del *:*)",
      "Bash(rm *:*)",

      // Code formatting (for hooks system)
      "Bash(./gradlew spotless*:*)",
      "Bash(gradlew.bat spotless*:*)"
    ]
  },

  "hooksConfig": {
    "autoFix": {
      "enabled": true,
      "maxRetries": 3,
      "failOnCritical": true,
      "failOnMajor": false
    },
    "autoFormat": {
      "enabled": true,
      "tool": "spotless",
      "trigger": "postAgentCompletion"
    },
    "autoRecordRules": {
      "enabled": true,
      "minSeverity": "minor",
      "destination": ".claude/shared/knowledge/quality-standards.md"
    },
    "notifications": {
      "onSuccess": true,
      "onFailure": true,
      "onFixAttempt": true,
      "verbose": true
    }
  }
}

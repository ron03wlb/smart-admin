{
  "allowedCommands": {
    "claude": {
      "loops": 100
    },
    "patterns": [
      // Version control
      "Bash(git *:*)",

      // Build tools (cross-platform)
      "Bash(./gradlew *:*)",
      "Bash(gradlew.bat *:*)",

      // Container management
      "Bash(docker *:*)",
      "Bash(docker-compose *:*)",

      // System utilities
      "Bash(netstat *:*)",
      "Bash(curl *:*)",

      // Text search (cross-platform)
      "Bash(findstr *:*)",
      "Bash(grep *:*)",

      // File operations (cross-platform)
      "Bash(dir *:*)",
      "Bash(ls *:*)",
      "Bash(find *:*)",
      "Bash(del *:*)",
      "Bash(rm *:*)"
    ]
  }
}

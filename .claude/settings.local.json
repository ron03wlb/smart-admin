{
  "permissions": {
    "allow": [
      "Bash(xargs -I {} sh -c 'echo \"\"=== {} ===\"\" && cat \"\"{}\"\"')",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(test:*)",
      "Bash(bash scripts/verify-config.sh:*)",
      "Bash(bash:*)"
    ]
  },
  "allowedCommands": {
    "claude": {
      "loops": 100
    },
    "patterns": [
      "Bash(git *:*)",
      "Bash(./gradlew *:*)",
      "Bash(gradlew.bat *:*)",
      "Bash(docker *:*)",
      "Bash(docker-compose *:*)",
      "Bash(netstat *:*)",
      "Bash(curl *:*)",
      "Bash(findstr *:*)",
      "Bash(grep *:*)",
      "Bash(dir *:*)",
      "Bash(ls *:*)",
      "Bash(find *:*)",
      "Bash(del *:*)",
      "Bash(rm *:*)",
      "Bash(./gradlew spotless*:*)",
      "Bash(gradlew.bat spotless*:*)"
    ]
  },
  "hooksConfig": {
    "autoFix": {
      "enabled": true,
      "maxRetries": 3,
      "failOnCritical": true,
      "failOnMajor": false
    },
    "autoFormat": {
      "enabled": true,
      "tool": "spotless",
      "trigger": "postAgentCompletion"
    },
    "autoRecordRules": {
      "enabled": true,
      "minSeverity": "minor",
      "destination": ".claude/shared/knowledge/quality-standards.md"
    },
    "notifications": {
      "onSuccess": true,
      "onFailure": true,
      "onFixAttempt": true,
      "verbose": true
    }
  }
}

{
  "permissions": {
    "allow": [
      "Bash(xargs -I {} sh -c 'echo \"\"=== {} ===\"\" && cat \"\"{}\"\"')",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(test:*)",
      "Bash(bash scripts/verify-config.sh:*)",
      "Bash(bash:*)",
      "Bash(git ls-tree:*)",
      "Bash(git sparse-checkout:*)",
      "Bash(git config:*)",
      "Bash(for file in architecture/overview.md testing-strategy.md unit-test-implementation-plan.md quick-reference.md architecture/fix-employee-transactional.md architecture/fix-role-transactional.md)",
      "Bash(do [ -f \"$file\" ])",
      "Bash(echo:*)",
      "Bash(do [ -f \"docs/testing/$file\" ])",
      "Bash(find:*)",
      "Bash(./gradlew:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(du:*)",
      "Bash(git show:*)",
      "Bash(done)",
      "Bash(grep:*)",
      "Bash(for f in sa-base/support/loginlog/src/main/resources/mapper/support/LoginLogMapper.xml sa-base/support/operatelog/src/main/resources/mapper/support/OperateLogMapper.xml sa-base/support/datatracer/src/main/resources/mapper/support/DataTracerMapper.xml sa-base/support/job/src/main/resources/mapper/support/SmartJobMapper.xml sa-base/support/job/src/main/resources/mapper/support/SmartJobLogMapper.xml)",
      "Bash(do if [ -f \"$f\" ])",
      "Bash(fi)",
      "Bash(for d in sa-base/support/login-log sa-base/support/operate-log sa-base/support/data-tracer sa-base/support/smart-job)",
      "Bash(do if [ -d \"$d\" ])",
      "Bash(git checkout:*)",
      "Bash(tree:*)",
      "Bash(unzip:*)",
      "Bash(jar tf:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(docker compose:*)",
      "Bash(docker info:*)",
      "Bash(tee:*)",
      "Bash(cat:*)",
      "Bash(git stash push:*)",
      "Bash(git stash:*)",
      "Bash(findstr:*)",
      "Bash(docker logs:*)",
      "Bash(.gradlew.bat:*)",
      "Bash(git mv:*)",
      "Bash(git reset:*)",
      "Bash(wc:*)",
      "Bash(chmod:*)",
      "Bash(./.claude/scripts/validate-links.sh:*)",
      "Bash(xargs cat:*)"
    ]
  },
  "allowedCommands": {
    "claude": {
      "loops": 100
    },
    "patterns": [
      "Bash(git *:*)",
      "Bash(./gradlew *:*)",
      "Bash(gradlew.bat *:*)",
      "Bash(docker *:*)",
      "Bash(docker-compose *:*)",
      "Bash(netstat *:*)",
      "Bash(curl *:*)",
      "Bash(findstr *:*)",
      "Bash(grep *:*)",
      "Bash(dir *:*)",
      "Bash(ls *:*)",
      "Bash(find *:*)",
      "Bash(del *:*)",
      "Bash(rm *:*)",
      "Bash(./gradlew spotless*:*)",
      "Bash(gradlew.bat spotless*:*)"
    ]
  },
  "hooksConfig": {
    "autoFix": {
      "enabled": true,
      "maxRetries": 3,
      "failOnCritical": true,
      "failOnMajor": false
    },
    "autoFormat": {
      "enabled": true,
      "tool": "spotless",
      "trigger": "postAgentCompletion"
    },
    "autoRecordRules": {
      "enabled": true,
      "minSeverity": "minor",
      "destination": ".claude/shared/knowledge/quality-standards.md"
    },
    "notifications": {
      "onSuccess": true,
      "onFailure": true,
      "onFixAttempt": true,
      "verbose": true
    }
  }
}

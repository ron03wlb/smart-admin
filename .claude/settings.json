{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file_path=$(echo $CLAUDE_TOOL_INPUT | jq -r '.file_path // .new_file_path // empty'); if echo \"$file_path\" | grep -q '\\.java$'; then cd smart-admin-api-java21-springboot3 && ./gradlew spotlessApply -q 2>/dev/null; fi",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file_path=$(echo $CLAUDE_TOOL_INPUT | jq -r '.file_path // .new_file_path // empty'); if echo \"$file_path\" | grep -qE '\\.(tsx?|jsx?)$'; then cd smart-admin-web-react && npx tsc --noEmit 2>&1 | head -20; fi",
            "timeout": 30000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo $CLAUDE_TOOL_INPUT | grep -qiE '(DROP TABLE|TRUNCATE|DELETE FROM|ALTER TABLE.*DROP|rm -rf)'; then echo 'BLOCKED: Destructive operation detected' >&2; exit 2; fi",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/code-change-summary.sh",
            "timeout": 3000
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ralph-loop@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7-plugin@context7-marketplace": true,
    "jdtls-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "developer-kit-java@developer-kit": true,
    "claude-hud@claude-hud": true
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Table Name Plural Patterns",
  "description": "Patterns to detect plural table names in SmartAdmin Entity @TableName annotations",
  "version": "1.0.0",
  "last_updated": "2026-02-02",

  "plural_patterns": [
    {
      "pattern": "_goods$",
      "description": "Irregular plural (good -> goods)",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_goods",
        "singular": "t_good"
      }
    },
    {
      "pattern": "_users$",
      "description": "Regular plural ending with s",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_users",
        "singular": "t_user"
      }
    },
    {
      "pattern": "_orders$",
      "description": "Regular plural ending with s",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_orders",
        "singular": "t_order"
      }
    },
    {
      "pattern": "_players$",
      "description": "Regular plural ending with s",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_players",
        "singular": "t_player"
      }
    },
    {
      "pattern": "_wallets$",
      "description": "Regular plural ending with s",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_wallets",
        "singular": "t_wallet"
      }
    },
    {
      "pattern": "_transactions$",
      "description": "Regular plural ending with s",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_transactions",
        "singular": "t_transaction"
      }
    },
    {
      "pattern": "_bonuses$",
      "description": "Regular plural ending with es",
      "singular_rule": "remove_es",
      "severity": "error",
      "example": {
        "plural": "t_bonuses",
        "singular": "t_bonus"
      }
    },
    {
      "pattern": "_games$",
      "description": "Regular plural ending with s",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_games",
        "singular": "t_game"
      }
    },
    {
      "pattern": "_activities$",
      "description": "Irregular plural (y -> ies)",
      "singular_rule": "replace_ies_with_y",
      "severity": "error",
      "example": {
        "plural": "t_activities",
        "singular": "t_activity"
      }
    },
    {
      "pattern": "_agents$",
      "description": "Regular plural ending with s",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_agents",
        "singular": "t_agent"
      }
    },
    {
      "pattern": "_tenants$",
      "description": "Regular plural ending with s",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_tenants",
        "singular": "t_tenant"
      }
    },
    {
      "pattern": "_brands$",
      "description": "Regular plural ending with s",
      "singular_rule": "remove_s",
      "severity": "error",
      "example": {
        "plural": "t_brands",
        "singular": "t_brand"
      }
    }
  ],

  "exemptions": [
    {
      "pattern": "_metrics$",
      "reason": "metrics is an uncountable noun representing aggregated statistical data",
      "examples": [
        "t_liteflow_execution_metrics",
        "t_performance_metrics",
        "t_user_metrics"
      ],
      "reference": ".agent/rules/foundation/01-naming-conventions.md (Section 7)"
    },
    {
      "pattern": "_statistics$",
      "reason": "statistics is conventionally used in plural form",
      "examples": [
        "t_user_statistics",
        "t_game_statistics",
        "t_financial_statistics"
      ],
      "reference": ".agent/rules/foundation/01-naming-conventions.md (Section 7)"
    },
    {
      "pattern": "_analytics$",
      "reason": "analytics is conventionally used in plural form",
      "examples": [
        "t_player_analytics",
        "t_behavior_analytics",
        "t_web_analytics"
      ],
      "reference": ".agent/rules/foundation/01-naming-conventions.md (Section 7)"
    }
  ],

  "metadata": {
    "total_plural_patterns": 12,
    "total_exemptions": 3,
    "coverage": "Common English plural forms",
    "maintainer": "SmartAdmin Architecture Team"
  }
}

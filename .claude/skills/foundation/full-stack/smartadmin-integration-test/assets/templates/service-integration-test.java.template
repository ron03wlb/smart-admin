    void delete{{entityName}}_ExistingId_MarksAsDeleted() {
      // When
      ResponseDTO<String> response = {{fieldName}}.delete{{entityName}}(test{{entityName}}Id);

      // Then - Verify ResponseDTO
      assertTrue(response.getOk(), "Expected success: " + response.getMsg());

      // Then - Verify soft delete (record still exists but deleted_flag = true)
      {{entityName}}Entity deleted = {{entityFieldName}}Dao.selectById(test{{entityName}}Id);
      assertNotNull(deleted, "Record should still exist");
      assertTrue(deleted.getDeletedFlag(), "Deleted flag should be true");

      // Then - Verify not returned in queries
      List<{{entityName}}Entity> active =
          {{entityFieldName}}Dao.selectList(
              Wrappers.<{{entityName}}Entity>lambdaQuery()
                  .eq({{entityName}}Entity::getDeletedFlag, false));
      assertFalse(
          active.stream().anyMatch(e -> e.get{{entityName}}Id().equals(test{{entityName}}Id)),
          "Deleted {{entityLower}} should not appear in active list");
    }


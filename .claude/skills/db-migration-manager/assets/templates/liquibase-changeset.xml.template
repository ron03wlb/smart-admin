<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!-- ============================================ -->
    <!-- Changeset: {{DESCRIPTION}} -->
    <!-- Author: {{AUTHOR}} -->
    <!-- Date: {{DATE}} -->
    <!-- Jira/Issue: {{TICKET_NUMBER}} -->
    <!-- ============================================ -->

    <changeSet id="{{VERSION}}-{{DESCRIPTION_SLUG}}" author="{{AUTHOR}}">

        <!-- Preconditions: Run only if conditions met -->
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="{{TABLE_NAME}}"/>
            </not>
        </preConditions>

        <!-- ============================================ -->
        <!-- Create Table -->
        <!-- ============================================ -->

        <createTable tableName="{{TABLE_NAME}}" remarks="{{TABLE_DESCRIPTION}}">
            <!-- Primary Key -->
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <!-- Business Columns -->
            <column name="{{COLUMN_NAME}}" type="{{COLUMN_TYPE}}" remarks="{{COLUMN_DESCRIPTION}}">
                <constraints nullable="{{NULLABLE}}" unique="{{UNIQUE}}"/>
            </column>

            <!-- Audit Columns (SmartAdmin BaseEntity pattern) -->
            <column name="created_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="BIGINT"/>
            <column name="updated_at" type="TIMESTAMP"/>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- ============================================ -->
        <!-- Add Column (Alternative) -->
        <!-- ============================================ -->

        <!-- <addColumn tableName="{{TABLE_NAME}}">
            <column name="{{COLUMN_NAME}}" type="{{COLUMN_TYPE}}" remarks="{{COLUMN_DESCRIPTION}}">
                <constraints nullable="{{NULLABLE}}"/>
            </column>
        </addColumn> -->

        <!-- ============================================ -->
        <!-- Modify Column (Alternative) -->
        <!-- ============================================ -->

        <!-- <modifyDataType tableName="{{TABLE_NAME}}"
                        columnName="{{COLUMN_NAME}}"
                        newDataType="{{NEW_TYPE}}"/> -->

        <!-- ============================================ -->
        <!-- Create Indexes -->
        <!-- ============================================ -->

        <createIndex indexName="idx_{{TABLE_NAME}}_{{COLUMN_NAME}}" tableName="{{TABLE_NAME}}">
            <column name="{{COLUMN_NAME}}"/>
        </createIndex>

        <!-- Composite Index -->
        <!-- <createIndex indexName="idx_{{TABLE_NAME}}_{{COLUMNS}}" tableName="{{TABLE_NAME}}">
            <column name="{{COLUMN1}}"/>
            <column name="{{COLUMN2}}"/>
        </createIndex> -->

        <!-- Unique Index -->
        <!-- <createIndex indexName="idx_{{TABLE_NAME}}_{{COLUMN_NAME}}_unique"
                     tableName="{{TABLE_NAME}}"
                     unique="true">
            <column name="{{COLUMN_NAME}}"/>
        </createIndex> -->

        <!-- ============================================ -->
        <!-- Add Foreign Key -->
        <!-- ============================================ -->

        <addForeignKeyConstraint
            baseTableName="{{TABLE_NAME}}"
            baseColumnNames="{{COLUMN_NAME}}"
            constraintName="fk_{{TABLE_NAME}}_{{REFERENCED_TABLE}}"
            referencedTableName="{{REFERENCED_TABLE}}"
            referencedColumnNames="{{REFERENCED_COLUMN}}"
            onDelete="{{CASCADE|RESTRICT|SET NULL}}"
            onUpdate="CASCADE"/>

        <!-- ============================================ -->
        <!-- Add Check Constraint -->
        <!-- ============================================ -->

        <!-- <addCheckConstraint
            tableName="{{TABLE_NAME}}"
            constraintName="chk_{{TABLE_NAME}}_{{COLUMN_NAME}}"
            checkCondition="{{COLUMN_NAME}} IN ({{VALUES}})"/> -->

        <!-- ============================================ -->
        <!-- Data Migration (Optional) -->
        <!-- ============================================ -->

        <!-- <sql>
            UPDATE {{TABLE_NAME}}
            SET {{COLUMN_NAME}} = {{DEFAULT_VALUE}}
            WHERE {{CONDITION}};
        </sql> -->

        <!-- ============================================ -->
        <!-- Rollback Instructions -->
        <!-- ============================================ -->

        <rollback>
            <!-- Automatic rollback for createTable -->
            <dropTable tableName="{{TABLE_NAME}}" cascadeConstraints="true"/>

            <!-- Manual rollback for complex changes -->
            <!-- <sql>
                ALTER TABLE {{TABLE_NAME}} DROP COLUMN {{COLUMN_NAME}};
            </sql> -->
        </rollback>

    </changeSet>

    <!-- ============================================ -->
    <!-- Additional Changesets -->
    <!-- ============================================ -->

    <!-- Add more changesets as needed -->

</databaseChangeLog>

# ====================================================================
# SmartAdmin Skill Configuration Template
# ====================================================================
# Version: 3.0.0
# Purpose: Standard configuration template for all SmartAdmin skills
# Usage: Copy this template when creating a new skill, fill in all
#        REQUIRED fields and relevant OPTIONAL fields
# ====================================================================

# ====================================================================
# Metadata (REQUIRED)
# ====================================================================
metadata:
  # Skill name (must match directory name)
  name: "{{SKILL_NAME}}"  # e.g., "smartadmin-crud-generator"

  # Semantic version
  version: "1.0.0"

  # Priority level (REQUIRED)
  # - P0: Critical foundation skills (mandatory for all development)
  # - P1: Important business logic and quality tools
  # - P2: Nice-to-have productivity enhancements
  priority: "{{P0|P1|P2}}"

  # Skill type (REQUIRED)
  # - atomic: Single-purpose, standalone skill
  # - composite: Multi-phase skill (e.g., CRUD generator)
  # - orchestrator: Coordinates multiple skills (e.g., batch-plan-executor)
  type: "{{atomic|composite|orchestrator}}"

  # Category (REQUIRED)
  # - backend: Java/Spring Boot backend skills
  # - frontend: Vue 3/TypeScript frontend skills
  # - full-stack: Combined backend + frontend skills
  # - domain: Business domain-specific skills (e.g., iGaming)
  # - orchestration: Meta-orchestration skills
  # - infrastructure: Infrastructure/DevOps skills
  # - quality: Code quality and testing skills
  # - analysis: Performance analysis and profiling
  category: "{{backend|frontend|full-stack|domain|orchestration|infrastructure|quality|analysis}}"

  # Brief one-line description (REQUIRED)
  description: "{{Brief description of what this skill does}}"

  # Detailed description for AI agents (OPTIONAL)
  ai_description: |
    {{Multi-line detailed description for AI agents.
    Includes:
    - Usage context and scenarios
    - When to invoke this skill
    - Key capabilities and features
    - Relationship to other skills}}

  # Search and filtering tags (OPTIONAL)
  tags:
    - "{{tag1}}"  # e.g., "crud", "code-generation", "testing"
    - "{{tag2}}"
    - "{{tag3}}"

  # Authorship and maintenance (OPTIONAL)
  author: "SmartAdmin Team"
  last_updated: "{{YYYY-MM-DD}}"
  status: "stable"  # stable | experimental | deprecated

# ====================================================================
# Trigger Configuration (REQUIRED)
# ====================================================================
triggers:
  # Primary keywords that should invoke this skill (REQUIRED)
  # When user mentions these phrases, AI should consider using this skill
  keywords:
    - "{{trigger keyword 1}}"  # e.g., "create CRUD module"
    - "{{trigger keyword 2}}"  # e.g., "generate entity"
    - "{{trigger keyword 3}}"  # e.g., "scaffold module"

  # Regex patterns for advanced matching (OPTIONAL)
  # Use when keyword matching isn't sufficient
  patterns:
    - "{{regex pattern 1}}"  # e.g., "generate\\s+(\\w+)\\s+CRUD"
    - "{{regex pattern 2}}"  # e.g., "create\\s+module\\s+for\\s+(\\w+)"

  # Anti-patterns - when NOT to trigger (OPTIONAL)
  # Prevents false positives
  exclude_keywords:
    - "{{exclude keyword 1}}"  # e.g., "delete CRUD"
    - "{{exclude keyword 2}}"  # e.g., "remove module"

# ====================================================================
# Execution Configuration (REQUIRED)
# ====================================================================
execution:
  # Execution type (REQUIRED)
  # - single-shot: Execute once, complete the task
  # - phase-based: Multi-phase execution (for composite skills)
  # - mode-based: Multiple execution modes (for composite skills)
  type: "{{single-shot|phase-based|mode-based}}"

  # For phase-based skills (OPTIONAL, required if type=phase-based)
  phases:
    - id: "phase-1"
      name: "{{Phase 1 Name}}"  # e.g., "Backend Generation"
      file: "phases/phase-1-{{name}}.md"
      required: true  # Is this phase mandatory?
      estimated_minutes: 10  # Estimated completion time

    - id: "phase-2"
      name: "{{Phase 2 Name}}"  # e.g., "Frontend Generation"
      file: "phases/phase-2-{{name}}.md"
      required: false  # Optional phase
      estimated_minutes: 8

  # For mode-based skills (OPTIONAL, required if type=mode-based)
  modes:
    - id: "{{mode-1}}"  # e.g., "diagnose"
      name: "{{Mode 1 Name}}"  # e.g., "Performance Diagnosis"
      file: "modes/mode-{{mode-1}}.md"
      default: false  # Is this the default mode?

    - id: "{{mode-2}}"  # e.g., "optimize"
      name: "{{Mode 2 Name}}"  # e.g., "Cache Optimization"
      file: "modes/mode-{{mode-2}}.md"
      default: true  # Default mode if not specified

  # Timeout settings (OPTIONAL)
  timeout:
    per_phase_minutes: 30  # Max time per phase
    total_minutes: 120  # Max total execution time

  # Quality gates (OPTIONAL)
  quality_gates:
    run_after_execution: true  # Auto-run quality checks after execution?
    checks:
      - "compilation"  # Gradle compilation check
      - "archunit"  # Architecture tests
      - "unit-tests"  # Unit test execution

# ====================================================================
# Dependencies (OPTIONAL)
# ====================================================================
dependencies:
  # Other skills this skill depends on (OPTIONAL)
  skills:
    - "{{dependency-skill-1}}"  # e.g., "test-fixture-generator"
    - "{{dependency-skill-2}}"

  # Required files in codebase (OPTIONAL)
  required_files:
    - "{{required-file-1}}"  # e.g., "CLAUDE.md"
    - "{{required-file-2}}"  # e.g., ".claude/shared/knowledge/smartadmin-patterns.md"

  # External tools required (OPTIONAL)
  tools:
    - name: "{{tool-name}}"  # e.g., "gradle"
      version: ">=8.0"  # Version requirement
      required: true  # Is this tool mandatory?

    - name: "{{tool-name-2}}"  # e.g., "docker"
      version: ">=20.0"
      required: false  # Optional tool

# ====================================================================
# Output Configuration (OPTIONAL)
# ====================================================================
output:
  # File types this skill generates (OPTIONAL)
  generates:
    - "{{file-pattern-1}}"  # e.g., "*.java"
    - "{{file-pattern-2}}"  # e.g., "*.vue"
    - "{{file-pattern-3}}"  # e.g., "*.ts"

  # Output locations (OPTIONAL)
  target_directories:
    - "{{target-dir-1}}"  # e.g., "smart-admin-api-java21-springboot3/smartadmin-modules/smartadmin-{module}/src/main/java"
    - "{{target-dir-2}}"  # e.g., "smart-admin-web/src/views"

  # Artifact templates (OPTIONAL)
  templates:
    entity: "templates/Entity.java.template"
    controller: "templates/Controller.java.template"
    service: "templates/Service.java.template"

# ====================================================================
# Validation Rules (OPTIONAL)
# ====================================================================
validation:
  # Pre-execution validation (OPTIONAL)
  pre_execution:
    - check: "codebase_structure"
      rule: "Must be in SmartAdmin project root"

    - check: "gradle_available"
      rule: "Gradle 8.0+ must be available"
      command: "gradle --version"

  # Post-execution validation (OPTIONAL)
  post_execution:
    - check: "compilation"
      description: "Verify code compiles successfully"
      command: "./gradlew :smartadmin-app:compileJava"

    - check: "archunit"
      description: "Verify architecture constraints"
      command: "./gradlew :smartadmin-app:test --tests ArchitectureTest"

    - check: "unit-tests"
      description: "Run unit tests"
      command: "./gradlew :smartadmin-app:test"

# ====================================================================
# Backward Compatibility (OPTIONAL)
# For deprecated skills only
# ====================================================================
compatibility:
  # Is this skill deprecated?
  deprecated: false

  # Deprecation phase (OPTIONAL, required if deprecated=true)
  # - soft: Display warning, command still works
  # - hard: Display error + migration guide, requires explicit flag
  # - removed: Skill removed, no longer accessible
  deprecation_phase: null  # soft | hard | removed

  # Replacement skill (OPTIONAL, required if deprecated=true)
  replacement_skill: null  # e.g., "smartadmin-crud-generator --backend-only"

  # Migration guide URL (OPTIONAL)
  migration_guide_url: null  # e.g., "https://smartadmin.ai/docs/migration/mybatis-to-crud"

  # Deprecation timeline (OPTIONAL)
  deprecated_since: null  # e.g., "2026-01-27"
  removal_date: null  # e.g., "2026-06-30"

# ====================================================================
# Documentation (REQUIRED)
# ====================================================================
documentation:
  # Main skill documentation file (REQUIRED)
  skill_md: "SKILL.md"

  # Human-friendly quick start guide (REQUIRED)
  readme: "README.md"

  # Examples directory (OPTIONAL)
  examples_dir: "examples/"

  # Reference documentation directory (OPTIONAL)
  references_dir: "references/"

  # External documentation links (OPTIONAL)
  external_links:
    - title: "SmartAdmin Patterns"
      url: "../../shared/knowledge/smartadmin-patterns.md"

    - title: "Architecture Rules"
      url: "CLAUDE.md"

# ====================================================================
# Monitoring & Analytics (OPTIONAL)
# ====================================================================
monitoring:
  # Track usage metrics?
  track_usage: true

  # Log executions?
  log_executions: true

  # Metrics to collect
  metrics:
    - "execution_time"
    - "success_rate"
    - "user_satisfaction"

# ====================================================================
# NOTES FOR SKILL CREATORS
# ====================================================================
# 1. Replace all {{placeholders}} with actual values
# 2. Delete OPTIONAL sections that don't apply to your skill
# 3. Ensure all REQUIRED sections are filled in
# 4. Validate your config.yml with: _shared/scripts/validate-config-schema.sh
# 5. Test your skill before committing
#
# For questions, see:
# - Template documentation: _shared/templates/README.md
# - Architecture guide: ../ARCHITECTURE.md

# ====================================================================

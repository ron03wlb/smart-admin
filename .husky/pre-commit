#!/bin/sh

# 檢查 Mermaid 閉合標記
echo "🔍 檢查 Mermaid 圖表語法..."

# 檢查暫存的 Markdown 文件中是否有錯誤的閉合標記
STAGED_MD_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.md$' || true)

if [ -n "$STAGED_MD_FILES" ]; then
    # 檢查這些文件是否包含錯誤的閉合標記
    ERROR_COUNT=0

    for file in $STAGED_MD_FILES; do
        # 排除審計報告（這些文件包含錯誤示例）
        if echo "$file" | grep -E "(CORRECTION_REPORT|AUDIT_REPORT)" > /dev/null; then
            continue
        fi

        # 檢查錯誤的閉合標記（使用四個反引號的錯誤模式）
        if grep -q '^````text$\|^````yaml$\|^````markdown$' "$file" 2>/dev/null; then
            echo "❌ 發現錯誤的 Mermaid 閉合標記: $file"
            ERROR_COUNT=$((ERROR_COUNT + 1))
        fi
    done

    if [ "$ERROR_COUNT" -gt 0 ]; then
        echo ""
        echo "❌ Pre-commit 檢查失敗！"
        echo "請修正 Mermaid 閉合標記錯誤"
        echo ""
        echo "或運行修正腳本："
        echo "  npm run check-mermaid:fix"
        exit 1
    fi

    echo "✅ Mermaid 語法檢查通過"
fi

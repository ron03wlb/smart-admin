<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- 排除生成代碼 -->
    <Match>
        <Source name="~.*target/generated-sources.*"/>
    </Match>
    <Match>
        <Class name="~.*MapperImpl"/>
    </Match>
    
    <!-- 排除測試代碼中的非 Bug 警告 -->
    <Match>
        <Class name="~.*Test"/>
        <Not>
            <Bug category="SECURITY"/>
        </Not>
    </Match>
    
    <!-- 排除配置類 -->
    <Match>
        <Class name="~.*Config"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
</FindBugsFilter>
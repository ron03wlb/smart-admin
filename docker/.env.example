# =============================================
# Smart Admin 21 - Docker 環境變量配置
# =============================================
# 複製此文件為 .env 並修改配置
# cp .env.example .env

# ---------------------------------------------
# 數據庫模式切換
# ---------------------------------------------
# local: 使用本地 PostgreSQL 容器
# supabase: 使用 Supabase 雲端數據庫
DB_MODE=local

# ---------------------------------------------
# PostgreSQL 本地配置（DB_MODE=local 時使用）
# ---------------------------------------------
POSTGRES_USER=smartadmin
POSTGRES_PASSWORD=SmartAdmin@2024
POSTGRES_DB=smart_admin
POSTGRES_PORT=5432

# ---------------------------------------------
# Supabase 配置（DB_MODE=supabase 時使用）
# Direct Connection 使用 Pooler
# ---------------------------------------------
SUPABASE_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_USER=postgres.your-project-ref
SUPABASE_PASSWORD=your-supabase-password
SUPABASE_DB=postgres

# Supabase API Keys（可選，用於 Edge Functions 等）
SUPABASE_PUBLIC_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_ACCESS_TOKEN=sbp_xxx

# ---------------------------------------------
# Redis 配置
# ---------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------
# Kafka 配置
# ---------------------------------------------
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# ---------------------------------------------
# Nginx 配置
# ---------------------------------------------
NGINX_HTTP_PORT=80

# ---------------------------------------------
# 前端配置（需要 --profile frontend）
# ---------------------------------------------
FRONTEND_PORT=3000
API_URL=http://localhost:8080

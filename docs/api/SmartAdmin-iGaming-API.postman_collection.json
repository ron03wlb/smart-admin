      },
      {
        "key": "key",
        "value": "Authorization",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:1024",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "7e775f88a6fd47be91f8854a43ff4eac",
      "type": "string"
    }

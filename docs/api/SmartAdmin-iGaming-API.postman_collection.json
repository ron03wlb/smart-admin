  "item": [
    {
      "name": "Wallet API",
      "item": [
        {
          "name": "Create Wallet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": 1,\n  \"walletType\": \"CASH\",\n  \"currency\": \"CNY\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/igaming/wallet/create",
              "host": ["{{base_url}}"],
              "path": ["igaming", "wallet", "create"]
            },
            "description": "Create a new wallet for a player (CASH, BONUS, or CREDIT type)"
          }
        },
        {
          "name": "Get Wallet by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/igaming/wallet/get/1",
              "host": ["{{base_url}}"],
              "path": ["igaming", "wallet", "get", "1"]
            },
            "description": "Get wallet details by wallet ID"
          }
        },
        {
          "name": "Query Wallets (Pagination)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"playerId\": 1,\n  \"walletType\": \"CASH\",\n  \"pageNum\": 1,\n  \"pageSize\": 10,\n  \"searchCount\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/igaming/wallet/query",
              "host": ["{{base_url}}"],
              "path": ["igaming", "wallet", "query"]
            },
            "description": "Query wallets with pagination and filters"
          }
        },
        {
          "name": "Credit (Deposit/Win)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": 1,\n  \"amount\": \"100.00\",\n  \"requestId\": \"credit_{{$timestamp}}\",\n  \"referenceType\": \"DEPOSIT\",\n  \"referenceId\": \"ORDER_001\",\n  \"description\": \"Bank deposit\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/igaming/wallet/credit",
              "host": ["{{base_url}}"],
              "path": ["igaming", "wallet", "credit"]
            },
            "description": "Add funds to wallet (deposit, game win, etc.)"
          }
        },
        {
          "name": "Debit (Bet/Withdraw)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": 1,\n  \"amount\": \"50.00\",\n  \"requestId\": \"debit_{{$timestamp}}\",\n  \"referenceType\": \"BET\",\n  \"referenceId\": \"GAME_ROUND_123\",\n  \"description\": \"Slot machine bet\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/igaming/wallet/debit",
              "host": ["{{base_url}}"],
              "path": ["igaming", "wallet", "debit"]
            },
            "description": "Deduct funds from wallet (bet, withdrawal, etc.)"
          }
        },
        {
          "name": "Lock Funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": 1,\n  \"lockAmount\": \"100.00\",\n  \"lockReason\": \"Withdrawal pending approval\",\n  \"referenceType\": \"WITHDRAWAL\",\n  \"referenceId\": \"WITHDRAW_001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/igaming/wallet/lock",
              "host": ["{{base_url}}"],
              "path": ["igaming", "wallet", "lock"]
            },
            "description": "Lock wallet funds (for withdrawal approval, etc.)"
          }
        },
        {
          "name": "Unlock Funds",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/igaming/wallet/unlock/700001",
              "host": ["{{base_url}}"],
              "path": ["igaming", "wallet", "unlock", "700001"]
            },
            "description": "Unlock previously locked funds by lock ID"
          }
        },
        {
          "name": "Query Transactions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletId\": 1,\n  \"transactionType\": \"CREDIT\",\n  \"pageNum\": 1,\n  \"pageSize\": 20,\n  \"searchCount\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/igaming/wallet/transaction/query",
              "host": ["{{base_url}}"],
              "path": ["igaming", "wallet", "transaction", "query"]
            },
            "description": "Query wallet transaction history with pagination"
          }
        },
        {
          "name": "Wallet Summary Report",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/igaming/wallet/report/summary?playerId=1",
              "host": ["{{base_url}}"],
              "path": ["igaming", "wallet", "report", "summary"],
              "query": [
                {
                  "key": "playerId",
                  "value": "1"
                }
              ]
            },
            "description": "Get wallet summary statistics (total balance, locked amount, etc.)"
          }
        }
      ],
      "description": "Wallet management API - create, query, credit, debit, lock/unlock funds"
    },

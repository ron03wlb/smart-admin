<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <!--
        SpotBugs Exclusion Filter for SmartAdmin

        This filter excludes false positives caused by:
        1. Lombok-generated getters/setters (EI/EI2)
        2. Spring @ConfigurationProperties binding requirements
        3. Standard Spring DI patterns (@RequiredArgsConstructor)
        4. Correct API usage (CompletableFuture.getNow(null))

        Created: 2026-01-22
        All 28 violations in mq module are verified false positives.
    -->

    <!-- ============================================================ -->
    <!-- LOMBOK + SPRING PATTERNS: @Data, @Builder, @ConfigurationProperties -->
    <!-- ============================================================ -->

    <!-- @ConfigurationProperties classes require mutable getters/setters -->
    <Match>
        <Class name="~.*Properties.*"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- Config classes (already in existing filter, ensuring consistency) -->
    <Match>
        <Class name="~.*Config"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- DTO/Result/Form/VO objects are data carriers, defensive copying unnecessary -->
    <Match>
        <Or>
            <Class name="~.*VO"/>
            <Class name="~.*DTO"/>
            <Class name="~.*Result"/>
            <Class name="~.*Form"/>
            <Class name="~.*Message"/>
        </Or>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- @Builder generated code creates builders that don't make defensive copies -->
    <Match>
        <Class name="~.*\$.*Builder"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
        @EqualsAndHashCode(callSuper = false) pattern
        QueryForm classes intentionally override equals without calling super.equals()
        This is by design for query parameter comparison (only compare own fields)
    -->
    <Match>
        <Or>
            <Class name="~.*QueryForm"/>
            <Class name="~.*Form"/>
        </Or>
        <Bug code="Eq"/>
    </Match>

    <!-- ============================================================ -->
    <!-- SPRING DEPENDENCY INJECTION PATTERNS -->
    <!-- ============================================================ -->

    <!--
        Spring @RequiredArgsConstructor injection pattern
        Spring-managed beans (KafkaTemplate, KafkaProperties, etc.) are singletons.
        Storing them via constructor is the standard and correct pattern.
    -->
    <Match>
        <Class name="~.*ServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="~.*Service"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="~.*Manager"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="~.*Controller"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="~.*Interceptor"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="~.*Dao"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!--
        Spring MVC Advice pattern (@ControllerAdvice, @RestControllerAdvice)
        Advice classes inject Spring-managed beans (ObjectMapper, etc.) via constructor.
        This is the standard and recommended pattern for cross-cutting concerns.
    -->
    <Match>
        <Class name="~.*Advice"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- ============================================================ -->
    <!-- CONSTRUCTOR VALIDATION PATTERN -->
    <!-- ============================================================ -->

    <!--
        CT_CONSTRUCTOR_THROW: Constructor throws exception
        This is a standard validation pattern. The theoretical "finalizer attack"
        requires untrusted code to subclass, which doesn't apply to internal classes.
        Alternative: make classes final, but that's not always practical.
    -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- ============================================================ -->
    <!-- API USAGE FALSE POSITIVES -->
    <!-- ============================================================ -->

    <!--
        CompletableFuture.getNow(null) is designed to accept null as fallback value.
        Kafka allows null keys for messages (round-robin distribution).
        SpotBugs incorrectly infers @NonNull requirements.
        Exclude all NP (null pointer) violations in KafkaProducerServiceImpl.
    -->
    <Match>
        <Class name="net.lab1024.sa.common.mq.kafka.core.KafkaProducerServiceImpl"/>
        <Bug code="NP"/>
    </Match>

    <!--
        JsonUtil uses @PostConstruct to initialize static field from Spring-injected instance.
        This is a standard pattern for bridging static utility API with Spring DI.
    -->
    <Match>
        <Class name="net.lab1024.sa.foundation.json.util.JsonUtil"/>
        <Or>
            <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- ============================================================ -->
    <!-- GENERATED CODE -->
    <!-- ============================================================ -->

    <!-- Exclude MapStruct generated code -->
    <Match>
        <Class name="~.*MapperImpl"/>
    </Match>

    <!-- Exclude generated sources -->
    <Match>
        <Source name="~.*target/generated-sources.*"/>
    </Match>

    <!-- ============================================================ -->
    <!-- TEST CODE (keep security checks) -->
    <!-- ============================================================ -->

    <Match>
        <Class name="~.*Test"/>
        <Not>
            <Bug category="SECURITY"/>
        </Not>
    </Match>
</FindBugsFilter>

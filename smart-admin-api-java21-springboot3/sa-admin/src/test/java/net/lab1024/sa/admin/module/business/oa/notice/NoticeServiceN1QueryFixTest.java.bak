package net.lab1024.sa.admin.module.business.oa.notice;

import static org.assertj.core.api.Assertions.assertThat;
import static org.mockito.ArgumentMatchers.anyList;
import static org.mockito.ArgumentMatchers.anyLong;
import static org.mockito.Mockito.times;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

import com.google.common.collect.Lists;
import java.time.LocalDateTime;
import java.util.List;
import net.lab1024.sa.admin.module.business.oa.notice.dao.NoticeDao;
import net.lab1024.sa.admin.module.business.oa.notice.dao.NoticeTypeDao;
import net.lab1024.sa.admin.module.business.oa.notice.domain.entity.NoticeEntity;
import net.lab1024.sa.admin.module.business.oa.notice.domain.entity.NoticeTypeEntity;
import net.lab1024.sa.admin.module.business.oa.notice.domain.vo.NoticeUpdateFormVO;
import net.lab1024.sa.admin.module.business.oa.notice.domain.vo.NoticeVisibleRangeVO;
import net.lab1024.sa.admin.module.business.oa.notice.service.NoticeService;
import net.lab1024.sa.admin.module.system.department.dao.DepartmentDao;
import net.lab1024.sa.admin.module.system.department.domain.vo.DepartmentVO;
import net.lab1024.sa.admin.module.system.employee.dao.EmployeeDao;
import net.lab1024.sa.admin.module.system.employee.domain.entity.EmployeeEntity;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

/**
 * NoticeService N+1 查詢修復驗證測試
 *
 * <p>測試目標: 驗證 getUpdateFormVO() 方法的 N+1 查詢問題已修復
 *
 * <p>修復前: 1000個部門通知 = 1001次數據庫查詢 (1次查詢通知 + 1000次逐個查詢部門) 修復後: 1000個部門通知 = 2次數據庫查詢 (1次查詢通知 +
 * 1次批量查詢部門)
 *
 * @author Claude Sonnet 4.5
 * @since 2026-01-30
 */
@ExtendWith(MockitoExtension.class)
class NoticeServiceN1QueryFixTest {

  @Mock private NoticeDao noticeDao;

  @Mock private NoticeTypeDao noticeTypeDao;

  @Mock private DepartmentDao departmentDao;

  @Mock private EmployeeDao employeeDao;

  @InjectMocks private NoticeService noticeService;

  @Test
  @DisplayName("驗證批量查詢部門數據 - 修復N+1查詢問題")
  void testBatchQueryDepartments_FixN1Query() {
    // Given: 準備測試數據
    Long noticeId = 1L;

    // 模擬通知實體
    NoticeEntity noticeEntity = new NoticeEntity();
    noticeEntity.setNoticeId(noticeId);
    noticeEntity.setNoticeTypeId(1L);
    noticeEntity.setAllVisibleFlag(false); // 非全員可見,需要查詢可見範圍
    noticeEntity.setPublishTime(LocalDateTime.now().minusDays(1));

    // 模擬可見範圍:2個員工 + 3個部門 (共5條記錄)
    List<NoticeVisibleRangeVO> visibleRangeList = Lists.newArrayList();
    visibleRangeList.add(createVisibleRange(101L, 1)); // 員工
    visibleRangeList.add(createVisibleRange(102L, 1)); // 員工
    visibleRangeList.add(createVisibleRange(201L, 2)); // 部門
    visibleRangeList.add(createVisibleRange(202L, 2)); // 部門
    visibleRangeList.add(createVisibleRange(203L, 2)); // 部門

    // 模擬員工數據
    List<EmployeeEntity> employeeList = Lists.newArrayList();
    employeeList.add(createEmployee(101L, "張三"));
    employeeList.add(createEmployee(102L, "李四"));

    // 模擬部門數據
    List<DepartmentVO> departmentList = Lists.newArrayList();
    departmentList.add(createDepartment(201L, "研發部"));
    departmentList.add(createDepartment(202L, "產品部"));
    departmentList.add(createDepartment(203L, "市場部"));

    // 模擬NoticeType
    NoticeTypeEntity noticeType = new NoticeTypeEntity();
    noticeType.setNoticeTypeId(1L);
    noticeType.setNoticeTypeName("系統公告");

    // 模擬Dao調用
    when(noticeDao.selectById(noticeId)).thenReturn(noticeEntity);
    when(noticeTypeDao.selectById(1L)).thenReturn(noticeType);
    when(noticeDao.queryVisibleRange(noticeId)).thenReturn(visibleRangeList);
    when(employeeDao.selectBatchIds(anyList())).thenReturn(employeeList);
    when(departmentDao.selectBatchDepartmentVO(anyList())).thenReturn(departmentList);

    // When: 執行查詢
    NoticeUpdateFormVO result = noticeService.getUpdateFormVO(noticeId);

    // Then: 驗證結果
    assertThat(result).isNotNull();
    assertThat(result.getVisibleRangeList()).hasSize(5);

    // 驗證員工名稱填充正確
    assertThat(result.getVisibleRangeList().get(0).getDataName()).isEqualTo("張三");
    assertThat(result.getVisibleRangeList().get(1).getDataName()).isEqualTo("李四");

    // 驗證部門名稱填充正確
    assertThat(result.getVisibleRangeList().get(2).getDataName()).isEqualTo("研發部");
    assertThat(result.getVisibleRangeList().get(3).getDataName()).isEqualTo("產品部");
    assertThat(result.getVisibleRangeList().get(4).getDataName()).isEqualTo("市場部");

    // 關鍵驗證: 確保批量查詢只調用一次 (修復N+1問題)
    verify(departmentDao, times(1)).selectBatchDepartmentVO(anyList());
    verify(departmentDao, times(0)).selectDepartmentVO(anyLong()); // 確保沒有單個查詢
  }

  @Test
  @DisplayName("驗證空部門列表場景 - 不執行批量查詢")
  void testEmptyDepartmentList_NoBatchQuery() {
    // Given: 準備測試數據 (只有員工,沒有部門)
    Long noticeId = 2L;

    NoticeEntity noticeEntity = new NoticeEntity();
    noticeEntity.setNoticeId(noticeId);
    noticeEntity.setNoticeTypeId(1L);
    noticeEntity.setAllVisibleFlag(false);
    noticeEntity.setPublishTime(LocalDateTime.now().minusDays(1));

    // 只有員工,沒有部門
    List<NoticeVisibleRangeVO> visibleRangeList = Lists.newArrayList();
    visibleRangeList.add(createVisibleRange(101L, 1)); // 員工

    List<EmployeeEntity> employeeList = Lists.newArrayList();
    employeeList.add(createEmployee(101L, "張三"));

    NoticeTypeEntity noticeType = new NoticeTypeEntity();
    noticeType.setNoticeTypeId(1L);
    noticeType.setNoticeTypeName("系統公告");

    when(noticeDao.selectById(noticeId)).thenReturn(noticeEntity);
    when(noticeTypeDao.selectById(1L)).thenReturn(noticeType);
    when(noticeDao.queryVisibleRange(noticeId)).thenReturn(visibleRangeList);
    when(employeeDao.selectBatchIds(anyList())).thenReturn(employeeList);

    // When: 執行查詢
    NoticeUpdateFormVO result = noticeService.getUpdateFormVO(noticeId);

    // Then: 驗證結果
    assertThat(result).isNotNull();
    assertThat(result.getVisibleRangeList()).hasSize(1);

    // 驗證沒有調用部門批量查詢
    verify(departmentDao, times(0)).selectBatchDepartmentVO(anyList());
  }

  @Test
  @DisplayName("性能測試 - 模擬1000個部門通知")
  void testPerformance_1000Departments() {
    // Given: 準備1000個部門的測試數據
    Long noticeId = 3L;

    NoticeEntity noticeEntity = new NoticeEntity();
    noticeEntity.setNoticeId(noticeId);
    noticeEntity.setNoticeTypeId(1L);
    noticeEntity.setAllVisibleFlag(false);
    noticeEntity.setPublishTime(LocalDateTime.now().minusDays(1));

    // 1000個部門
    List<NoticeVisibleRangeVO> visibleRangeList = Lists.newArrayList();
    List<DepartmentVO> departmentList = Lists.newArrayList();
    for (long i = 1; i <= 1000; i++) {
      visibleRangeList.add(createVisibleRange(i, 2)); // 部門類型
      departmentList.add(createDepartment(i, "部門" + i));
    }

    when(noticeDao.selectById(noticeId)).thenReturn(noticeEntity);
    when(noticeDao.queryVisibleRange(noticeId)).thenReturn(visibleRangeList);
    when(departmentDao.selectBatchDepartmentVO(anyList())).thenReturn(departmentList);

    // When: 執行查詢並計時
    long startTime = System.currentTimeMillis();
    NoticeUpdateFormVO result = noticeService.getUpdateFormVO(noticeId);
    long endTime = System.currentTimeMillis();

    // Then: 驗證結果
    assertThat(result).isNotNull();
    assertThat(result.getVisibleRangeList()).hasSize(1000);

    // 關鍵驗證: 1000個部門只需1次批量查詢 (而非1000次單獨查詢)
    verify(departmentDao, times(1)).selectBatchDepartmentVO(anyList());
    verify(departmentDao, times(0)).selectDepartmentVO(anyLong());

    System.out.println("查詢1000個部門耗時: " + (endTime - startTime) + "ms");
    System.out.println("✅ N+1查詢問題已修復: 1000個部門只需1次批量查詢");
  }

  // ========== 測試數據構建方法 ==========

  private NoticeVisibleRangeVO createVisibleRange(Long dataId, Integer dataType) {
    NoticeVisibleRangeVO vo = new NoticeVisibleRangeVO();
    vo.setDataId(dataId);
    vo.setDataType(dataType);
    return vo;
  }

  private EmployeeEntity createEmployee(Long employeeId, String actualName) {
    EmployeeEntity entity = new EmployeeEntity();
    entity.setEmployeeId(employeeId);
    entity.setActualName(actualName);
    return entity;
  }

  private DepartmentVO createDepartment(Long departmentId, String departmentName) {
    DepartmentVO vo = new DepartmentVO();
    vo.setDepartmentId(departmentId);
    vo.setDepartmentName(departmentName);
    return vo;
  }
}
